{
  "name": "peiskos-mobile",
  "productName": "Peiskos",
  "version": "0.1.0",
  "private": true,
  "description": "Android and iPhone apps for Peiskos: the same client as the web and desktop apps, in a phone app shell",
  "scripts": {
    "copy-client": "node scripts/copy-client.js",
    "sync": "npm run copy-client && cap sync",
    "android": "npm run sync && cap open android",
    "ios": "npm run sync && cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "8.5.3",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@capawesome/capacitor-badge": "^8.0.4"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3"
  }
}
