<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Alerts from the server, through Apple. Release builds switch this to production when signed. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- The folder shared with the share extension (ShareExtension/). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.app.peiskos</string>
	</array>
</dict>
</plist>
