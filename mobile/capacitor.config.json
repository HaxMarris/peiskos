{
  "appId": "app.peiskos",
  "appName": "Peiskos",
  "webDir": "app",
  "backgroundColor": "#f6f0e7",
  "android": {
    "allowMixedContent": false
  },
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#f6f0e7"
  },
  "plugins": {
    "Keyboard": {
      "resize": "native",
      "autoBackdropColor": "dom"
    },
    "SplashScreen": {
      "launchAutoHide": false,
      "launchFadeOutDuration": 250,
      "showSpinner": false
    },
    "PushNotifications": {
      "presentationOptions": []
    }
  }
}
